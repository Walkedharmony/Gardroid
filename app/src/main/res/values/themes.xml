<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.Gardroid" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/md_theme_light_primary</item>
        <item name="colorOnPrimary">@color/md_theme_light_onPrimary</item>
        <item name="colorPrimaryContainer">@color/md_theme_light_primaryContainer</item>
        <item name="colorOnPrimaryContainer">@color/md_theme_light_onPrimaryContainer</item>
        
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/md_theme_light_secondary</item>
        <item name="colorOnSecondary">@color/md_theme_light_onSecondary</item>
        
        <!-- Background colors -->
        <item name="android:colorBackground">@color/md_theme_light_background</item>
        <item name="colorOnBackground">@color/md_theme_light_onBackground</item>
        <item name="colorSurface">@color/md_theme_light_surface</item>
        <item name="colorOnSurface">@color/md_theme_light_onSurface</item>
        <item name="colorSurfaceVariant">@color/md_theme_light_surfaceVariant</item>
        <item name="colorOnSurfaceVariant">@color/md_theme_light_onSurfaceVariant</item>
        
        <!-- Status bar color. -->
        <item name="android:statusBarColor">?attr/colorSurface</item>
        <item name="android:windowLightStatusBar">true</item>
        
        <!-- Semantic File Colors (Light) -->
        <item name="colorFolderText">@color/folder_text_light</item>
        <item name="colorFolderBg">@color/folder_bg_light</item>
        <item name="colorArchiveText">@color/archive_text_light</item>
        <item name="colorArchiveBg">@color/archive_bg_light</item>
        <item name="colorImageText">@color/image_text_light</item>
        <item name="colorImageBg">@color/image_bg_light</item>
        <item name="colorScriptText">@color/script_text_light</item>
        <item name="colorScriptBg">@color/script_bg_light</item>
        <item name="colorAudioText">@color/audio_text_light</item>
        <item name="colorAudioBg">@color/audio_bg_light</item>
        <item name="colorDefaultText">@color/default_text_light</item>
        <item name="colorDefaultBg">@color/default_bg_light</item>
    </style>

    <style name="Theme.Gardroid" parent="Base.Theme.Gardroid" />
</resources>